# Production environment template (deployment behind Cloudflare Tunnel).
# Copy to .env.prod on the server, set your own domain and real secrets. Never commit .env.prod.

# Domain & URLs
NEXT_PUBLIC_APP_NAME="RTMS"
NEXT_PUBLIC_API_BASE_URL="https://docmans.example.org/api/v1"
WEB_ORIGIN="https://docmans.example.org"
ACCOUNT_LOGIN_URL="https://docmans.example.org/login"

# PostgreSQL
POSTGRES_DB="docmansystem"
POSTGRES_USER="docmansystem"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_DB_PASSWORD"

# MinIO
MINIO_ACCESS_KEY="docmans-minio"
MINIO_SECRET_KEY="CHANGE_ME_STRONG_MINIO_PASSWORD"
MINIO_BUCKET_NAME="rtms-files"
MINIO_REGION="us-east-1"

# File upload limits
FILE_MAX_UPLOAD_BYTES=10485760
FILE_ALLOWED_EXTENSIONS=".doc,.docx,.pdf,.xls,.xlsx"

# Cloudflare Tunnel token (tunnel routes your domain -> http://nginx:80)
CLOUDFLARE_TUNNEL_TOKEN="PASTE_CLOUDFLARE_TUNNEL_TOKEN_HERE"

# Security & Observability
# Khoá ký CSRF tối thiểu 32 ký tự (openssl rand -base64 32). Đổi khoá khiến người dùng đang mở trang phải tải lại.
CSRF_SECRET="CHANGE_ME_CSRF_SECRET_AT_LEAST_32_CHARS"
# Xác thực 2 lớp qua Email OTP: off | required-roles (chỉ bật required-roles khi SMTP đã hoạt động và các tài khoản quản trị/lãnh đạo có thư công vụ)
LOGIN_OTP_MODE="off"
# CSP: report-only | enforce | off (chạy report-only để kiểm tra log csp_violation trước khi chuyển enforce)
CSP_MODE="report-only"
# Log API: errors (mặc định: 5xx + request >= 1s) | all | off
LOG_REQUESTS="errors"
# Tuỳ chọn tách tài khoản MinIO quyền tối thiểu trong bucket cho API (mặc định dùng MINIO_ACCESS_KEY/SECRET_KEY)
MINIO_APP_ACCESS_KEY=""
MINIO_APP_SECRET_KEY=""

# Optional SMTP for credential emails & 2FA OTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_FROM=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false

# Initial production admin password (only used when running prisma:seed manually, >= 12 chars)
SEED_ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD_12_CHARS"
