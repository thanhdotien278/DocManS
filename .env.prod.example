# Production environment for May 29 (khqs.thanhdotien.com).
# Copy to .env.prod on May 29 and fill in real secrets. Never commit .env.prod.

# Domain & URLs
NEXT_PUBLIC_APP_NAME="RTMS"
NEXT_PUBLIC_API_BASE_URL="https://khqs.thanhdotien.com/api/v1"
WEB_ORIGIN="https://khqs.thanhdotien.com"
ACCOUNT_LOGIN_URL="https://khqs.thanhdotien.com/login"

# PostgreSQL
POSTGRES_DB="docmansystem"
POSTGRES_USER="docmansystem"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_DB_PASSWORD"

# MinIO
MINIO_ACCESS_KEY="docmans-minio"
MINIO_SECRET_KEY="CHANGE_ME_STRONG_MINIO_PASSWORD"
MINIO_BUCKET_NAME="rtms-files"
MINIO_REGION="us-east-1"

# File upload limits
FILE_MAX_UPLOAD_BYTES=10485760
FILE_ALLOWED_EXTENSIONS=".doc,.docx,.pdf,.xls,.xlsx"

# Cloudflare Tunnel token (tunnel: khqs-docmans -> khqs.thanhdotien.com)
CLOUDFLARE_TUNNEL_TOKEN="PASTE_CLOUDFLARE_TUNNEL_TOKEN_HERE"

# Optional SMTP for credential emails
SMTP_HOST=""
SMTP_PORT=587
SMTP_FROM=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false

# Initial production admin password (only used when running prisma:seed manually, >= 12 chars)
SEED_ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD_12_CHARS"
