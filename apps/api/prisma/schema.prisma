generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                  @id @default(uuid())
  username           String                  @unique
  usernameKey        String                  @unique @map("username_key")
  displayName        String                  @map("display_name")
  passwordHash       String                  @map("password_hash")
  status             String
  role               String
  roleLabel          String                  @map("role_label")
  unit               String
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  sessions           Session[]
  auditLogs          AuditLog[]
  roleAssignments    UserRoleAssignment[]
  organizationScopes UserOrganizationScope[]

  @@map("users")
}

model Role {
  id          String               @id @default(uuid())
  code        String               @unique
  label       String
  description String?
  status      String               @default("active")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  assignments UserRoleAssignment[]

  @@map("roles")
}

model OrganizationUnit {
  id         String                  @id @default(uuid())
  code       String                  @unique
  name       String
  parentId   String?                 @map("parent_id")
  parent     OrganizationUnit?       @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children   OrganizationUnit[]      @relation("OrganizationHierarchy")
  status     String                  @default("active")
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  userScopes UserOrganizationScope[]

  @@index([parentId])
  @@map("organization_units")
}

model UserRoleAssignment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model UserOrganizationScope {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  organizationUnitId String           @map("organization_unit_id")
  isPrimary          Boolean          @default(false) @map("is_primary")
  createdAt          DateTime         @default(now()) @map("created_at")
  user               User             @relation(fields: [userId], references: [id])
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id])

  @@unique([userId, organizationUnitId])
  @@index([organizationUnitId])
  @@map("user_organization_scopes")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id])
  targetEntity String? @map("target_entity")
  targetEntityId String? @map("target_entity_id")
  username  String?
  timestamp DateTime @default(now())
  result    String
  ip        String?
  userAgent String?  @map("user_agent")
  reason    String?

  @@index([action])
  @@index([actorId])
  @@index([targetEntity, targetEntityId])
  @@index([timestamp])
  @@map("audit_logs")
}

model CatalogItem {
  id          String    @id @default(uuid())
  type        String
  code        String
  name        String
  description String?
  status      String    @default("active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([type, code])
  @@index([type])
  @@index([deletedAt])
  @@map("catalog_items")
}

model SystemParameter {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  label     String
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_parameters")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  subject   String
  body      String
  status    String   @default("active")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notification_templates")
}
