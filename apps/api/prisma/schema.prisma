generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                  @id @default(uuid())
  username           String                  @unique
  usernameKey        String                  @unique @map("username_key")
  displayName        String                  @map("display_name")
  passwordHash       String                  @map("password_hash")
  status             String
  legacyRole         String?                 @map("legacy_role")
  systemRole         String?                 @map("system_role")
  legacyRoleLabel    String?                 @map("legacy_role_label")
  unit               String
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  sessions           Session[]
  passwordResetTokens PasswordResetToken[] @relation("PasswordResetTarget")
  issuedPasswordResetTokens PasswordResetToken[] @relation("PasswordResetIssuer")
  auditLogs          AuditLog[]
  systemRoleMigrationIssues SystemRoleMigrationIssue[]
  organizationScopes UserOrganizationScope[]
  ownedResearchProposals ResearchProposal[] @relation("ProposalOwner")
  submittedResearchProposals ResearchProposal[] @relation("ProposalSubmitter")
  uploadedProposalAttachments ProposalAttachment[] @relation("AttachmentUploader")
  uploadedFileRecords FileRecord[] @relation("FileRecordUploader")
  proposalSubmissionEvents ProposalSubmissionEvent[] @relation("SubmissionActor")
  proposalSupplementRequests ProposalSupplementRequest[] @relation("SupplementRequestActor")
  proposalParticipations ProposalMember[] @relation("ProposalParticipant")
  proposalReviewAssignments ProposalReviewAssignment[] @relation("ReviewAssignmentReviewer")
  assignedProposalReviews ProposalReviewAssignment[] @relation("ReviewAssignmentAssigner")
  proposalReviews ProposalReview[] @relation("ProposalReviewReviewer")
  createdEvaluationSummaries ProposalEvaluationSummary[] @relation("EvaluationSummaryCreator")
  updatedEvaluationSummaries ProposalEvaluationSummary[] @relation("EvaluationSummaryEditor")
  proposalDecisions ProposalDecision[] @relation("ProposalDecisionAuthority")
  grantedProposalDelegations ProposalDelegation[] @relation("ProposalDelegationGrantor")
  receivedProposalDelegations ProposalDelegation[] @relation("ProposalDelegationDelegate")
  approvedProposalDelegations ProposalDelegation[] @relation("ProposalDelegationApprover")
  createdResearcherProfiles ResearcherProfile[] @relation("ResearcherProfileCreator")
  updatedResearcherProfiles ResearcherProfile[] @relation("ResearcherProfileUpdater")

  @@map("users")
}

model SystemRoleMigrationIssue {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  roles     Json     @map("roles")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("system_role_migration_issues")
}

model OrganizationUnit {
  id         String                  @id @default(uuid())
  code       String                  @unique
  name       String
  parentId   String?                 @map("parent_id")
  parent     OrganizationUnit?       @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children   OrganizationUnit[]      @relation("OrganizationHierarchy")
  status     String                  @default("active")
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  userScopes UserOrganizationScope[]
  proposalIntakePeriods ProposalIntakePeriod[]
  hostedResearchProposals ResearchProposal[]
  researcherProfiles ResearcherProfile[]

  @@index([parentId])
  @@map("organization_units")
}

model UserOrganizationScope {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  organizationUnitId String           @map("organization_unit_id")
  isPrimary          Boolean          @default(false) @map("is_primary")
  createdAt          DateTime         @default(now()) @map("created_at")
  user               User             @relation(fields: [userId], references: [id])
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id])

  @@unique([userId, organizationUnitId])
  @@index([organizationUnitId])
  @@map("user_organization_scopes")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  createdById String   @map("created_by_id")
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation("PasswordResetTarget", fields: [userId], references: [id])
  createdBy   User     @relation("PasswordResetIssuer", fields: [createdById], references: [id])

  @@index([userId, usedAt, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id])
  targetEntity String? @map("target_entity")
  targetEntityId String? @map("target_entity_id")
  username  String?
  timestamp DateTime @default(now())
  result    String
  ip        String?
  userAgent String?  @map("user_agent")
  reason    String?
  correlationId String? @map("correlation_id")
  beforeFacts Json? @map("before_facts")
  afterFacts Json? @map("after_facts")

  @@index([action])
  @@index([actorId])
  @@index([targetEntity, targetEntityId])
  @@index([timestamp])
  @@map("audit_logs")
}

model CatalogItem {
  id          String    @id @default(uuid())
  type        String
  code        String
  name        String
  description String?
  status      String    @default("active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  researcherProfileAcademicRanks ResearcherProfile[] @relation("ResearcherProfileAcademicRank")
  researcherProfileAcademicDegrees ResearcherProfile[] @relation("ResearcherProfileAcademicDegree")
  researcherProfileFields ResearcherProfileField[] @relation("ResearcherProfileResearchField")

  @@unique([type, code])
  @@index([type])
  @@index([deletedAt])
  @@map("catalog_items")
}

model ResearcherProfile {
  id                         String        @id @default(uuid())
  managementOrganizationUnitId String      @map("management_organization_unit_id")
  managementOrganizationUnit OrganizationUnit @relation(fields: [managementOrganizationUnitId], references: [id])
  externalAffiliation        String?       @map("external_affiliation")
  fullName                   String        @map("full_name")
  fullNameKey                String        @map("full_name_key")
  academicRankCatalogItemId  String?       @map("academic_rank_catalog_item_id")
  academicRankCatalogItem    CatalogItem?  @relation("ResearcherProfileAcademicRank", fields: [academicRankCatalogItemId], references: [id])
  academicDegreeCatalogItemId String?      @map("academic_degree_catalog_item_id")
  academicDegreeCatalogItem  CatalogItem?  @relation("ResearcherProfileAcademicDegree", fields: [academicDegreeCatalogItemId], references: [id])
  title                      String?
  contactEmail               String?       @map("contact_email")
  contactEmailKey            String?       @map("contact_email_key")
  contactPhone               String?       @map("contact_phone")
  contactPhoneKey            String?       @map("contact_phone_key")
  contactNote                String?       @map("contact_note")
  status                     String        @default("ACTIVE")
  aggregateVersion           Int           @default(0) @map("aggregate_version")
  createdById                String        @map("created_by_id")
  createdBy                  User          @relation("ResearcherProfileCreator", fields: [createdById], references: [id])
  updatedById                String        @map("updated_by_id")
  updatedBy                  User          @relation("ResearcherProfileUpdater", fields: [updatedById], references: [id])
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")
  researchFields             ResearcherProfileField[]
  expertiseKeywords          ResearcherProfileExpertiseKeyword[]

  @@index([managementOrganizationUnitId, status, fullNameKey])
  @@index([contactEmailKey])
  @@index([contactPhoneKey])
  @@map("researcher_profiles")
}

model ResearcherProfileField {
  id                 String          @id @default(uuid())
  researcherProfileId String         @map("researcher_profile_id")
  researcherProfile  ResearcherProfile @relation(fields: [researcherProfileId], references: [id], onDelete: Cascade)
  catalogItemId      String          @map("catalog_item_id")
  catalogItem        CatalogItem     @relation("ResearcherProfileResearchField", fields: [catalogItemId], references: [id])
  createdAt          DateTime        @default(now()) @map("created_at")

  @@unique([researcherProfileId, catalogItemId])
  @@index([catalogItemId])
  @@map("researcher_profile_fields")
}

model ResearcherProfileExpertiseKeyword {
  id                 String          @id @default(uuid())
  researcherProfileId String         @map("researcher_profile_id")
  researcherProfile  ResearcherProfile @relation(fields: [researcherProfileId], references: [id], onDelete: Cascade)
  keyword            String
  keywordKey         String          @map("keyword_key")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@unique([researcherProfileId, keywordKey])
  @@index([keywordKey])
  @@map("researcher_profile_expertise_keywords")
}

model SystemParameter {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  label     String
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_parameters")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  subject   String
  body      String
  status    String   @default("active")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notification_templates")
}

model ProposalIntakePeriod {
  id                           String            @id @default(uuid())
  code                         String            @unique
  title                        String
  description                  String?
  startsAt                     DateTime          @map("starts_at")
  endsAt                       DateTime          @map("ends_at")
  status                       String            @default("draft")
  applicableOrganizationUnitId String?           @map("applicable_organization_unit_id")
  applicableOrganizationUnit   OrganizationUnit? @relation(fields: [applicableOrganizationUnitId], references: [id])
  requiredPackage              Json              @map("required_package")
  createdAt                    DateTime          @default(now()) @map("created_at")
  updatedAt                    DateTime          @updatedAt @map("updated_at")
  proposals                    ResearchProposal[]

  @@index([status])
  @@index([applicableOrganizationUnitId])
  @@map("proposal_intake_periods")
}

model ResearchProposal {
  id                     String                    @id @default(uuid())
  code                   String?                   @unique
  intakePeriodId         String                    @map("intake_period_id")
  intakePeriod           ProposalIntakePeriod      @relation(fields: [intakePeriodId], references: [id])
  ownerId                String                    @map("owner_id")
  owner                  User                      @relation("ProposalOwner", fields: [ownerId], references: [id])
  hostOrganizationUnitId String                    @map("host_organization_unit_id")
  hostOrganizationUnit   OrganizationUnit          @relation(fields: [hostOrganizationUnitId], references: [id])
  researchFieldCode      String?                   @map("research_field_code")
  proposalTypeCode       String?                   @map("proposal_type_code")
  title                  String
  objectives             String?
  summary                String?
  startDate              DateTime?                 @map("start_date")
  endDate                DateTime?                 @map("end_date")
  budgetMetadata         Json?                     @map("budget_metadata")
  status                 String                    @default("draft")
  submittedAt            DateTime?                 @map("submitted_at")
  submittedById          String?                   @map("submitted_by_id")
  submittedBy            User?                     @relation("ProposalSubmitter", fields: [submittedById], references: [id])
  authorizationRelationshipVersion Int             @default(0) @map("authorization_relationship_version")
  authorizationConflictVersion     Int             @default(0) @map("authorization_conflict_version")
  authorizationDelegationVersion   Int             @default(0) @map("authorization_delegation_version")
  authorizationContextUpdatedAt    DateTime        @default(now()) @map("authorization_context_updated_at")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  members                ProposalMember[]
  attachments            ProposalAttachment[]
  submissionEvents       ProposalSubmissionEvent[]
  supplementRequests     ProposalSupplementRequest[]
  reviewAssignments      ProposalReviewAssignment[]
  reviews                ProposalReview[]
  evaluationSummary      ProposalEvaluationSummary?
  decisions              ProposalDecision[]
  delegations            ProposalDelegation[]

  @@index([intakePeriodId])
  @@index([ownerId])
  @@index([hostOrganizationUnitId])
  @@index([status])
  @@map("research_proposals")
}

model ProposalDelegation {
  id                     String           @id @default(uuid())
  proposalId             String           @map("proposal_id")
  proposal               ResearchProposal @relation(fields: [proposalId], references: [id])
  grantorUserId          String           @map("grantor_user_id")
  grantor                User             @relation("ProposalDelegationGrantor", fields: [grantorUserId], references: [id])
  delegateUserId         String           @map("delegate_user_id")
  delegate               User             @relation("ProposalDelegationDelegate", fields: [delegateUserId], references: [id])
  approverUserId         String?          @map("approver_user_id")
  approver               User?            @relation("ProposalDelegationApprover", fields: [approverUserId], references: [id])
  targetOrganizationUnitId String         @map("target_organization_unit_id")
  actionIds              Json             @map("action_ids")
  sourceAuthorityVersion Json             @map("source_authority_version")
  startsAt               DateTime         @map("starts_at")
  endsAt                 DateTime?        @map("ends_at")
  status                 String           @default("PENDING_APPROVAL")
  approvedAt             DateTime?        @map("approved_at")
  revokedAt              DateTime?        @map("revoked_at")
  reason                 String
  createdAt              DateTime         @default(now()) @map("created_at")

  @@index([proposalId, delegateUserId, status])
  @@index([proposalId, grantorUserId, status])
  @@map("proposal_delegations")
}

model ProposalMember {
  id                String           @id @default(uuid())
  proposalId        String           @map("proposal_id")
  proposal          ResearchProposal @relation(fields: [proposalId], references: [id])
  userId            String?          @map("user_id")
  user              User?            @relation("ProposalParticipant", fields: [userId], references: [id])
  name              String
  role              String
  participationRole String           @default("member") @map("participation_role")
  status            String           @default("ACTIVE")
  effectiveFrom     DateTime         @default(now()) @map("effective_from")
  effectiveUntil    DateTime?        @map("effective_until")
  organization      String
  createdAt         DateTime         @default(now()) @map("created_at")

  @@index([proposalId])
  @@index([userId])
  @@index([participationRole])
  @@index([proposalId, userId, participationRole, status])
  @@map("proposal_members")
}

model ProposalAttachment {
  id              String           @id @default(uuid())
  proposalId      String           @map("proposal_id")
  proposal        ResearchProposal @relation(fields: [proposalId], references: [id])
  requirementCode String           @map("requirement_code")
  fileName        String           @map("file_name")
  mimeType        String           @map("mime_type")
  sizeBytes       Int              @map("size_bytes")
  storageKey      String           @map("storage_key")
  uploadedById    String           @map("uploaded_by_id")
  uploadedBy      User             @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  status          String           @default("active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([proposalId])
  @@index([uploadedById])
  @@index([requirementCode])
  @@map("proposal_attachments")
}

model FileRecord {
  id                String    @id @default(uuid())
  relatedEntityType String    @map("related_entity_type")
  relatedEntityId   String    @map("related_entity_id")
  filePurpose       String    @map("file_purpose")
  originalFileName  String    @map("original_file_name")
  description       String?
  mimeType          String    @map("mime_type")
  sizeBytes         Int       @map("size_bytes")
  storageBucket     String    @map("storage_bucket")
  storageObjectKey  String    @map("storage_object_key")
  uploadedById      String    @map("uploaded_by_id")
  uploadedBy        User      @relation("FileRecordUploader", fields: [uploadedById], references: [id])
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@index([relatedEntityType, relatedEntityId])
  @@index([uploadedById])
  @@index([filePurpose])
  @@index([status])
  @@index([deletedAt])
  @@map("file_records")
}

model ProposalSubmissionEvent {
  id          String           @id @default(uuid())
  proposalId  String           @map("proposal_id")
  proposal    ResearchProposal @relation(fields: [proposalId], references: [id])
  actorId     String           @map("actor_id")
  actor       User             @relation("SubmissionActor", fields: [actorId], references: [id])
  fromStatus  String           @map("from_status")
  toStatus    String           @map("to_status")
  submittedAt DateTime         @default(now()) @map("submitted_at")
  note        String?

  @@index([proposalId])
  @@index([actorId])
  @@map("proposal_submission_events")
}

model ProposalSupplementRequest {
  id          String           @id @default(uuid())
  proposalId  String           @map("proposal_id")
  proposal    ResearchProposal @relation(fields: [proposalId], references: [id])
  actorId     String           @map("actor_id")
  actor       User             @relation("SupplementRequestActor", fields: [actorId], references: [id])
  reason      String
  dueDate     DateTime         @map("due_date")
  requestedAt DateTime         @default(now()) @map("requested_at")
  resolvedAt  DateTime?        @map("resolved_at")
  status      String           @default("open")

  @@index([proposalId])
  @@index([actorId])
  @@index([status])
  @@map("proposal_supplement_requests")
}

/// ST-3.2 — reviewer access is granted per assignment, never by account role alone.
model ProposalReviewAssignment {
  id             String           @id @default(uuid())
  proposalId     String           @map("proposal_id")
  proposal       ResearchProposal @relation(fields: [proposalId], references: [id])
  reviewerUserId String           @map("reviewer_user_id")
  reviewer       User             @relation("ReviewAssignmentReviewer", fields: [reviewerUserId], references: [id])
  assignmentRole String           @default("reviewer") @map("assignment_role")
  status         String           @default("assigned")
  assignedById   String           @map("assigned_by_id")
  assignedBy     User             @relation("ReviewAssignmentAssigner", fields: [assignedById], references: [id])
  assignedAt     DateTime         @default(now()) @map("assigned_at")
  effectiveFrom  DateTime         @default(now()) @map("effective_from")
  effectiveUntil DateTime?        @map("effective_until")
  dueDate        DateTime?        @map("due_date")
  revokedAt      DateTime?        @map("revoked_at")
  completedAt    DateTime?        @map("completed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  review         ProposalReview?

  @@index([proposalId])
  @@index([reviewerUserId])
  @@index([status])
  @@map("proposal_review_assignments")
}

/// ST-3.3 — one review per assignment, owned by the assigned reviewer.
model ProposalReview {
  id             String                   @id @default(uuid())
  proposalId     String                   @map("proposal_id")
  proposal       ResearchProposal         @relation(fields: [proposalId], references: [id])
  assignmentId   String                   @unique @map("assignment_id")
  assignment     ProposalReviewAssignment @relation(fields: [assignmentId], references: [id])
  reviewerUserId String                   @map("reviewer_user_id")
  reviewer       User                     @relation("ProposalReviewReviewer", fields: [reviewerUserId], references: [id])
  status         String                   @default("draft")
  scoreData      Json?                    @map("score_data")
  totalScore     Int?                     @map("total_score")
  comment        String?
  recommendation String?
  submittedAt    DateTime?                @map("submitted_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  @@index([proposalId])
  @@index([reviewerUserId])
  @@index([status])
  @@map("proposal_reviews")
}

/// ST-3.4 — one consolidated staff outcome per proposal.
model ProposalEvaluationSummary {
  id             String           @id @default(uuid())
  proposalId     String           @unique @map("proposal_id")
  proposal       ResearchProposal @relation(fields: [proposalId], references: [id])
  summary        String
  recommendation String
  status         String           @default("draft")
  createdById    String           @map("created_by_id")
  createdBy      User             @relation("EvaluationSummaryCreator", fields: [createdById], references: [id])
  updatedById    String           @map("updated_by_id")
  updatedBy      User             @relation("EvaluationSummaryEditor", fields: [updatedById], references: [id])
  markedReadyAt  DateTime?        @map("marked_ready_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@map("proposal_evaluation_summaries")
}

/// ST-3.5 — the leadership decision, kept as history even if a later policy reopens the proposal.
model ProposalDecision {
  id          String           @id @default(uuid())
  proposalId  String           @map("proposal_id")
  proposal    ResearchProposal @relation(fields: [proposalId], references: [id])
  decision    String
  note        String?
  decidedById String           @map("decided_by_id")
  decidedBy   User             @relation("ProposalDecisionAuthority", fields: [decidedById], references: [id])
  decidedAt   DateTime         @default(now()) @map("decided_at")
  fromStatus  String           @map("from_status")
  toStatus    String           @map("to_status")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([proposalId])
  @@index([decidedById])
  @@index([decision])
  @@map("proposal_decisions")
}
