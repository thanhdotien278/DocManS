{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@rtms/contracts": ["packages/contracts/src/index.ts"],
      "@rtms/permissions": ["packages/permissions/src/index.ts"],
      "@rtms/ui-tokens": ["packages/ui-tokens/src/index.ts"],
      "@rtms/validation": ["packages/validation/src/index.ts"]
    }
  }
}
